# ============================================================================
# RIFTARA — Environment Configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ============================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# DATABASE_DRIVER=pglite   -> embedded PostgreSQL, zero setup, stored in ./.data
# DATABASE_DRIVER=postgres -> managed PostgreSQL (Supabase, RDS, Neon, ...)
DATABASE_DRIVER=pglite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riftara
PGLITE_DATA_DIR=./.data/riftara-db

# --- Authentication --------------------------------------------------------
# 32+ byte random secret. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-value-min-32-bytes
AUTH_SESSION_TTL_HOURS=12
AUTH_PROVIDER=credentials          # credentials | supabase
AUTH_MFA_ENABLED=false

# --- Demo / Seed Data ------------------------------------------------------
# When true the UI shows the DEMO DATA banner and seeded records are flagged.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
SEED_DEFAULT_PASSWORD="Riftara#2025"

# --- Object Storage --------------------------------------------------------
STORAGE_DRIVER=local               # local | supabase | s3
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_UPLOAD_MB=25

# --- Supabase (optional; required when AUTH_PROVIDER/STORAGE_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=riftara

# --- Maps ------------------------------------------------------------------
MAP_PROVIDER=static                # static | google | mapbox
NEXT_PUBLIC_MAP_PROVIDER=static
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- API Layer -------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=120
API_KEY_SALT=change-me-api-key-salt

# --- Email / SMTP ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RIFTARA <no-reply@riftara.example>"

# --- Integrations (leave blank => "Configuration Required") -----------------
EJAR_API_BASE_URL=
EJAR_API_KEY=
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_KEY=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ANALYTICS_PROPERTY_ID=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
MONDAY_API_TOKEN=
ERP_API_BASE_URL=
ERP_API_KEY=
WEBSITE_WEBHOOK_SECRET=
